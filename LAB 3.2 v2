
#include <iostream>
#include <cmath>
using namespace std;
int main()
{
	setlocale(LC_ALL, "Ukranian");
	double x;
	double a;
	double b;
	double c;
	double f;
	
	cout << "a = "; cin >> a;
	cout << "b = "; cin >> b;
	cout << "c = "; cin >> c;
	cout << "x = "; cin >> x;
	if (x < 0.6 && b + c != 0)
		f = a * pow(x, 2) + pow(b, 2) + c;
	else
		if (x > 0.6 && b + c == 0)
			f = (x - a) / (x - c);
		else
			f = (x / c) + (x / a);
	cout << "2) f = " << f << endl;
	cin.get();
	return 0;

}

